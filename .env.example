# DNI — contoh variabel lingkungan. Isi nilai asli hanya di .env.local (tidak di-commit).

# Mode autentikasi. "mock" hanya untuk pengembangan lokal dan TIDAK aman untuk production.
DNI_AUTH_MODE=mock

# Penyedia AI. "mock" = respons simulasi, tidak ada data yang dikirim keluar.
DNI_AI_PROVIDER=mock

# Wajib "true" sebelum penyedia AI eksternal boleh dipanggil. Jangan aktifkan
# sebelum ada persetujuan internal tentang data yang boleh dikirim ke model.
DNI_ALLOW_EXTERNAL_AI=false

# Diisi nanti saat integrasi (Fase 2+). Kunci hanya di server, jangan diberi prefix NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
